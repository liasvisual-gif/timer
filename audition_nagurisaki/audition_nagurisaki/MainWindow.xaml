                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="ViDaVo" Margin="0,0,0,10" Padding="8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="Vi が1位、Da が2位" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="表示:" Width="60"/>
                                            <ComboBox x:Name="cmbUtahimeRule6Display1" Width="90">`n
                                                <ComboBoxItem Content="Vo" IsSelected="True"/>
                                                <ComboBoxItem Content="Da"/>
                                                <ComboBoxItem Content="Vi"/>
                                            </ComboBox>
                                            <TextBlock Text=" → " Margin="2,0"/>
                                                    <ComboBox x:Name="cmbUtahimeRule6Display2" Width="90">`n
                                                        <ComboBoxItem Content="Vo"/>
                                                        <ComboBoxItem Content="Da"/>
                                                        <ComboBoxItem Content="Vi" IsSelected="True"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </TabItem>

                    <TabItem x:Name="tabFixedClick" Header="定点クリック">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <CheckBox x:Name="chkAutoClickEnabled" Content="定点クリック有効" IsChecked="True" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <TextBlock Text="オデ入室キー:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="txtJudgeKey" Text="Space" Width="50" Margin="0,0,0,0"/>
                                    <Button Content="パターン編集" Width="80" Height="25" Click="BtnOpenPatternEditor_Click" Margin="20,0,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="presetRegArea" Margin="0,5,0,0">
                                    <!-- 編集エリア -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="名前:" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox x:Name="txtPresetName" Width="80" Margin="0,0,10,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="X:" VerticalAlignment="Center" Width="18"/>
                                        <TextBox x:Name="txtPresetX" Width="60" Margin="0,0,10,0"/>
                                        <TextBlock Text="Y:" VerticalAlignment="Center" Width="18"/>
                                        <TextBox x:Name="txtPresetY" Width="60" Margin="0,0,10,0"/>
                                        <TextBlock Text="遅延:" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox x:Name="txtPresetDelay" Width="50" Margin="0,0,5,0"/>
                                        <RepeatButton Content="▲" Width="20" Height="12" FontSize="8" Click="BtnPresetDelayUp_Click" VerticalAlignment="Top"/>
                                        <RepeatButton Content="▼" Width="20" Height="12" FontSize="8" Click="BtnPresetDelayDown_Click" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <!-- ボタン -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Button Content="作成" Width="45" Height="25" Click="BtnAddPreset_Click" Margin="0,0,5,0"/>
                                        <Button Content="削除" Width="45" Height="25" Click="BtnDeletePreset_Click" Margin="0,0,5,0"/>
                                        <Button Content="保存" Width="45" Height="25" Click="BtnApplyPreset_Click" Margin="0,0,5,0"/>
                                        <Button Content="↑" Width="30" Height="25" Click="BtnMovePresetUp_Click" Margin="0,0,3,0"/>
                                        <Button Content="↓" Width="30" Height="25" Click="BtnMovePresetDown_Click"/>
                                    </StackPanel>
                                    <!-- プリセット一覧 -->
                                    <DataGrid x:Name="dgPresets" AutoGenerateColumns="False" IsReadOnly="True"
                                              MaxHeight="200" SelectionMode="Single" SelectionChanged="DgPresets_SelectionChanged"
                                              HeadersVisibility="Column" CanUserSortColumns="False" CanUserReorderColumns="False"
                                              CanUserResizeRows="False" GridLinesVisibility="All" Margin="0,5,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="80"/>
                                            <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60"/>
                                            <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60"/>
                                            <DataGridTextColumn Header="遅延" Binding="{Binding Delay}" Width="50"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="tabProgression" Header="オデ進行">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="オーディション進行設定" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                <TextBlock Text="窓ごとにオーディション進行とボマー表示を設定します" Foreground="Gray" FontSize="11" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="対象窓:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                                    <ComboBox x:Name="cmbProgressionWindow" Width="100" SelectionChanged="CmbProgressionWindow_SelectionChanged">
                                        <ComboBoxItem Content="8窓1" Tag="1" IsSelected="True"/>
                                        <ComboBoxItem Content="8窓2" Tag="2"/>
                                        <ComboBoxItem Content="8窓3" Tag="3"/>
                                        <ComboBoxItem Content="単窓" Tag="0"/>
                                        <ComboBoxItem Content="3窓1" Tag="4"/>
                                        <ComboBoxItem Content="3窓2" Tag="5"/>
                                        <ComboBoxItem Content="3窓3" Tag="6"/>
                                    </ComboBox>
                                    <Button Content="現在の窓から全窓にコピー" Width="160" Height="25" Margin="10,0,0,0" Click="BtnCopyProgressionToAll_Click"/>
                                </StackPanel>

                                <GroupBox Header="ボマー表示" Margin="0,0,0,8" Padding="5">
                                    <StackPanel>
                                        <TextBlock Text="ボマーを表示する週を選択" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                                        <WrapPanel x:Name="bomberCheckContainer"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="山あり進行" Margin="0,0,0,8" Padding="5">
                                    <StackPanel x:Name="yamaAriContainer"/>
                                </GroupBox>

                                <GroupBox Header="山なし進行" Padding="5">
                                    <StackPanel x:Name="yamaNashiContainer"/>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <GroupBox x:Name="grpWeekInfo" Header="週情報" Margin="0,10,0,10" Padding="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock x:Name="lblWeek" Text="現在の週:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtWeek" Width="50" Text="4-1" IsReadOnly="True"/>
                            <Button x:Name="btnWeekBack" Content="◀" Width="30" Height="25" Click="BtnWeekBack_Click" Margin="10,0,5,0"/>
                            <Button x:Name="btnWeekForward" Content="▶" Width="30" Height="25" Click="BtnWeekForward_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="モード:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button x:Name="btnToggleYama" Content="山あり" Width="70" Height="25" Click="BtnToggleYama_Click" Background="LimeGreen" FontWeight="Bold"/>
                            <TextBlock x:Name="txtYamaModeStatus" Text="山あり" FontWeight="Bold" FontSize="14" Foreground="Green" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock Text="切替キー:" VerticalAlignment="Center" Margin="15,0,3,0"/>
                            <TextBox x:Name="txtYamaToggleKey" Text="" Width="40"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="表示設定" Margin="0,0,0,8" Padding="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="フォントサイズ:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtFontSize" Width="50" Text="200"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="表示ウィンドウ枚数:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="cmbWindowCount" Width="50" SelectedIndex="0">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,15" HorizontalAlignment="Left">
                    <Button x:Name="btnSaveSettings" Content="設定保存" Width="90" Height="35" Click="BtnSaveSettings_Click" Margin="0,0,10,0" FontSize="12"/>
                    <Button x:Name="btnLoadSettings" Content="設定読込" Width="90" Height="35" Click="BtnLoadSettings_Click" Margin="0,0,10,0" FontSize="12"/>
                    <Button x:Name="btnLaunch" Content="表示" Width="90" Height="35" Click="BtnLaunch_Click" Margin="0,0,10,0" FontSize="12"/>
                    <Button x:Name="btnClose" Content="閉じる" Width="90" Height="35" Click="BtnClose_Click" FontSize="12"/>
                </StackPanel>

                <TextBlock x:Name="txtStatus" Text="Waiting..." Foreground="Gray" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
    </ScrollViewer>
</Window>






   




