<Window x:Class="audition_nagurisaki.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:audition_nagurisaki"
    mc:Ignorable="d"
    Title="審査員殴り" Height="850" Width="500" 
    Background="White"
    PreviewMouseDown="Window_PreviewMouseDown">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="8" HorizontalAlignment="Left">
        <TextBlock x:Name="txtTitle" Text="審査員殴り" Foreground="Black" FontWeight="Bold" FontSize="20" Margin="0,0,0,10" HorizontalAlignment="Left"/>
        
        <!-- 現在の窓状態表示 -->
        <GroupBox Header="現在の窓" Margin="0,0,0,8" Padding="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="アクティブ窓:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="txtCurrentWindow" Text="窓1" FontWeight="Bold" FontSize="16" Foreground="Blue" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="窓移動キー:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="1:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox x:Name="txtMoveToWindow1Key" Text="Z" Width="30" Margin="0,0,10,0"/>
                <TextBlock Text="2:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox x:Name="txtMoveToWindow2Key" Text="X" Width="30" Margin="0,0,10,0"/>
                <TextBlock Text="3:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox x:Name="txtMoveToWindow3Key" Text="C" Width="30"/>
            </StackPanel>
        </GroupBox>

        <TabControl Height="420">
                    <TabItem x:Name="tabSettings" Header="設定">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <!-- 登録キー設定 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="座標登録キー:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="txtCoordRegKey" Text="R" Width="40" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="txtCoordRegStatus" Text="(アクティブ: なし)" Foreground="Blue" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <GroupBox x:Name="grpWindow1" Header="窓1 識別座標" Margin="0,0,0,8" Padding="5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <RadioButton x:Name="rbCoord11" GroupName="CoordReg" Content="" Margin="0,0,5,0" VerticalAlignment="Center" Checked="CoordRadioButton_Checked"/>
                                            <TextBlock Text="座標1: X=" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtX11" Width="55" Text="100"/>
                                            <TextBlock Text=" Y=" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtY11" Width="55" Text="100"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <RadioButton x:Name="rbCoord12" GroupName="CoordReg" Content="" Margin="0,0,5,0" VerticalAlignment="Center" Checked="CoordRadioButton_Checked"/>
                                            <TextBlock Text="座標2: X=" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtX12" Width="55" Text="200"/>
                                            <TextBlock Text=" Y=" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtY12" Width="55" Text="100"/>
