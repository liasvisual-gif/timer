<Window x:Class="audition_nagurisaki.OverlayWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Display" 
WindowStyle="None" 
AllowsTransparency="True" 
Background="Transparent"
Topmost="True"
ShowInTaskbar="False"
Width="400"
Height="300"
ResizeMode="NoResize"
MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Toggle Transparent" Click="ContextMenu_ToggleTransparent_Click"/>
                <Separator/>
                <MenuItem Header="Close" Click="ContextMenu_Close_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
        
        <Border x:Name="bgPanel" 
                Background="#F0F0F0" 
                BorderBrush="#333" 
                BorderThickness="2" 
                CornerRadius="10"
                Visibility="Collapsed">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           x:Name="txtTitle"
                           Text="Audition Result" 
                           FontSize="18" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,10"/>
                
                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Grid>
                        <TextBlock x:Name="txtVoWithBg" 
                                   Text="Vo" 
                                   FontSize="100" 
                                   FontWeight="Bold"
                                   Foreground="Red"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        
                        <TextBlock x:Name="txtDaWithBg" 
                                   Text="Da" 
                                   FontSize="100" 
                                   FontWeight="Bold"
                                   Foreground="Blue"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        
                        <TextBlock x:Name="txtViWithBg" 
                                   Text="Vi" 
                                   FontSize="100" 
                                   FontWeight="Bold"
                                   Foreground="Yellow"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Viewbox>
                
                <TextBlock Grid.Row="2" 
                           x:Name="txtStatusInfo"
                           Text="Right-click to toggle transparent mode" 
                           FontSize="10" 
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,10,0,5"/>
            </Grid>
        </Border>
        
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                <TextBlock x:Name="txtWeekInfo"
                    Text="4-8"
                    FontSize="60"
                    FontWeight="Bold"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="0,0,2,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="txtNagurisaki"
                    Text=""
                    FontSize="60"
                    FontWeight="Bold"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="2,0,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
            
            <!-- Colored Result Display -->
            <StackPanel x:Name="coloredResultPanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="txtResult1"
                    Text=""
                    FontSize="200"
                    FontWeight="Bold"
                    HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="txtResultArrow"
                    Text="&#x2192;"
                    FontSize="200"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="txtResult2"
                    Text=""
                    FontSize="200"
                    FontWeight="Bold"
                    HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
            
            <TextBlock x:Name="txtVo" 
                       Text="Vo" 
                       FontSize="200" 
                       FontWeight="Bold"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            
            <TextBlock x:Name="txtDa" 
                       Text="Da" 
                       FontSize="200" 
                       FontWeight="Bold"
                       Foreground="Blue"
                       HorizontalAlignment="Center"
                       Margin="0"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            
            <TextBlock x:Name="txtVi" 
                       Text="Vi" 
                       FontSize="200" 
                       FontWeight="Bold"
                       Foreground="Yellow"
                       HorizontalAlignment="Center"
                       Margin="0"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="0" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>

