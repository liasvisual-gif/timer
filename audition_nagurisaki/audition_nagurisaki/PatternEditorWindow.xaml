<Window x:Class="audition_nagurisaki.PatternEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パターン編集" Height="550" Width="700" Background="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MaxHeight="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- パターン一覧 -->
        <DataGrid x:Name="dgPatterns" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="DgPatterns_SelectionChanged"
                  HeadersVisibility="Column" CanUserSortColumns="False" CanUserReorderColumns="False"
                  CanUserResizeRows="False" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="30"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="100"/>
                <DataGridTextColumn Header="Hotkey" Binding="{Binding Hotkey}" Width="60"/>
                <DataGridTextColumn Header="窓" Binding="{Binding WindowLabel}" Width="50"/>
                <DataGridTextColumn Header="Patterns" Binding="{Binding Summary}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 編集コントロール -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <TextBox x:Name="txtPatternName" Width="120" Margin="0,0,10,0"/>
            <TextBlock Text="Hotkey" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <TextBox x:Name="txtPatternHotkey" Width="50" Margin="0,0,10,0"/>
            <TextBlock Text="窓" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <ComboBox x:Name="cmbPatternWindow" Width="65" Margin="0,0,10,0">
                <ComboBoxItem Content="全窓" Tag="-1" IsSelected="True"/>
                <ComboBoxItem Content="8窓1" Tag="1"/>
                <ComboBoxItem Content="8窓2" Tag="2"/>
                <ComboBoxItem Content="8窓3" Tag="3"/>
                <ComboBoxItem Content="単窓" Tag="0"/>
                <ComboBoxItem Content="3窓1" Tag="4"/>
                <ComboBoxItem Content="3窓2" Tag="5"/>
                <ComboBoxItem Content="3窓3" Tag="6"/>
            </ComboBox>
            <Button Content="パターン追加" Width="80" Height="25" Click="BtnAddPattern_Click" Margin="0,0,5,0"/>
            <Button Content="更新" Width="50" Height="25" Click="BtnUpdatePattern_Click" Margin="0,0,5,0"/>
            <Button Content="削除" Width="50" Height="25" Click="BtnDeletePattern_Click" Margin="0,0,5,0"/>
            <Button Content="閉じる" Width="50" Height="25" Click="BtnClose_Click"/>
        </StackPanel>

        <!-- 下部: 定点一覧 + ボタン | パターン内容 -->
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 定点一覧 + ボタン -->
            <DockPanel Grid.Column="0" Margin="0,0,5,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Button Content="←除去" Width="55" Height="25" Click="BtnRemoveFromPattern_Click" Margin="0,0,5,0"/>
                    <Button Content="追加→" Width="55" Height="25" Click="BtnAddToPattern_Click" Margin="0,0,5,0"/>
                    <Button Content="↑" Width="30" Height="25" Click="BtnMoveStepUp_Click" Margin="0,0,3,0"/>
                    <Button Content="↓" Width="30" Height="25" Click="BtnMoveStepDown_Click"/>
                </StackPanel>
                <ListBox x:Name="lstAllPresets"/>
            </DockPanel>

            <!-- 右: パターン内容 -->
            <DataGrid x:Name="dgPatternSteps" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" CanUserSortColumns="False"
                      CanUserReorderColumns="False" CanUserResizeRows="False" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Idx" Binding="{Binding Idx}" Width="40"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="WaitAfter(ms)" Binding="{Binding WaitAfter}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
